{
  "name": "shortlinker",
  "version": "1.0.0",
  "private": true,
  "description": "ShortLinker — YouTube Shorts Related Video Manager Chrome Extension",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "package": "tsc --noEmit && node scripts/build.mjs && node scripts/package.mjs",
    "watch": "tsc --noEmit && node scripts/build.mjs --watch --sourcemap",
    "test": "npx vite-node scripts/test.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
