{
  "manifest_version": 3,
  "name": "ShortLinker — YouTube Shorts Related Video Manager",
  "version": "1.0.0",
  "description": "Bulk assign one Related Video to multiple YouTube Shorts directly from YouTube Studio.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "interceptor.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "interceptor.js"
      ],
      "matches": [
        "https://studio.youtube.com/*"
      ]
    }
  ]
}
